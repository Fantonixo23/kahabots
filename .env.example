# Copiar a .env y completar. El .env nunca se sube al repo.

# No hace falta ninguna clave de API. Google Places quedo descartado porque
# exige tarjeta de credito y cobra por consulta. Los negocios se sacan de
# padrones oficiales publicos: python datos/descargar_padrones.py

# Numero desde el que se escribe, en formato internacional sin + ni espacios.
# Solo informativo: el bot NO envia nada solo, arma el link wa.me y vos aperes enviar.
MI_NUMERO=

# Zona horaria de referencia para los horarios de envio.
ZONA_HORARIA=America/Asuncion

# Limite diario de mensajes. El bot nunca lo supera.
LIMITE_DIARIO=35
